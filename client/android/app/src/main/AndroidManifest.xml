<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== 权限（最小权限原则） ==================== -->
    <!-- 唯一必需的基础权限：访问 Kepler 服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载完成 / 进度通知（API 33+ 运行时权限，仅在用户下载时按需申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 下载前台服务：大文件下载期间保活并展示进度通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 刻意不申请：READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE /
         READ_MEDIA_* / MANAGE_EXTERNAL_STORAGE —— 上传走系统文档选择器（SAF），
         下载写入 MediaStore 下载集合，均无需任何存储权限 -->

    <application
        android:name=".KeplerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Kepler">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Kepler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 下载前台服务（dataSync 类型，API 34 要求显式声明） -->
        <service
            android:name=".service.DownloadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
