# 统一换行符，避免 Windows / macOS 之间产生整文件级 diff
* text=auto

# 源码与配置按文本处理
*.kt text
*.kts text
*.java text
*.xml text
*.md text
*.pro text
*.toml text
*.properties text
*.gitignore text
*.gitattributes text

# Gradle wrapper 脚本必须保持各自的换行风格，否则在对应平台上无法执行
gradlew text eol=lf
gradlew.bat text eol=crlf

# 二进制资源不做换行转换
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.jks binary
*.keystore binary
